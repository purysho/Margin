{
  "name": "margin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-drafted, teacher-approved feedback for EFL writing.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply margin --local",
    "db:migrate:remote": "wrangler d1 migrations apply margin --remote -c wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy && npm run db:migrate:remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
