{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Free tier: open models on Workers AI, inside Cloudflare's free daily allocation.
  "ai": { "binding": "AI" },
  "vars": { "FREE_DAILY_LIMIT": "20" },
  // Daily privacy clean-up: deletes recordings older than 30 days.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: `wrangler deploy` creates a D1 database named "margin"
      // on the first deploy and reuses it after that.
      "database_name": "margin",
      "migrations_dir": "migrations"
    }
  ]
}
